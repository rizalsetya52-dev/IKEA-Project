  library(ggplot2)

# grid skor brand_trust sesuai rentang data asli (1 - 4,67)
grid <- data.frame(brand_trust = seq(1, 4.67, length.out = 100))

# prediksi + interval kepercayaan 95%
pred <- predict(m2, newdata = grid, type = "link", se.fit = TRUE)
grid$prob  <- plogis(pred$fit)
grid$lower <- plogis(pred$fit - 1.96 * pred$se.fit)
grid$upper <- plogis(pred$fit + 1.96 * pred$se.fit)

# data asli (0/1) untuk titik latar
df$repeat_bin <- ifelse(df$repeat_purchase == "Ya", 1, 0)

ggplot(grid, aes(x = brand_trust, y = prob)) +
  geom_point(data = df, aes(y = repeat_bin), alpha = 0.15,
             position = position_jitter(height = 0.02)) +
  geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.2) +
  geom_line(linewidth = 1) +
  scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
  labs(title = "Peluang Repeat Purchase berdasarkan Brand Trust",
