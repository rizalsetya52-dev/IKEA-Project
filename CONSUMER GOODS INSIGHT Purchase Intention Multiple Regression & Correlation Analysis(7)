install.packages("ggplot2")   # sekali saja
library(ggplot2)

# rentang x sesuai data aslimu (supaya tidak ekstrapolasi)
x  <- seq(min(df$purchase_intention), max(df$purchase_intention), length.out = 50)
nd <- expand.grid(purchase_intention = x, brand_trust = c(2, 3, 4))

pr <- predict(m3, newdata = nd, type = "link", se.fit = TRUE)
nd$p  <- plogis(pr$fit)
nd$lo <- plogis(pr$fit - 1.96 * pr$se.fit)
nd$hi <- plogis(pr$fit + 1.96 * pr$se.fit)
nd$trust <- factor(nd$brand_trust, labels = c("Trust 2", "Trust 3", "Trust 4"))

ggplot(nd, aes(purchase_intention, p, color = trust, fill = trust)) +
  geom_ribbon(aes(ymin = lo, ymax = hi), alpha = 0.15, color = NA) +
  geom_line(linewidth = 1.1) +
  scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
  labs(title = "Peluang beli ulang naik seiring niat beli dan kepercayaan brand",
       x = "Purchase intention (1-5)", y = "Peluang beli ulang",
       color = NULL, fill = NULL) +
  theme_minimal(base_size = 13) +
  theme(legend.position = "top")




