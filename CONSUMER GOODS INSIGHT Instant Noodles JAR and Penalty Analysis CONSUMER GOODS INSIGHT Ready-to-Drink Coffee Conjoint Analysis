# D3. Bandingkan Rating vs Choice (importance dan part-worth distandarisasi)
bind_rows(imp_rating %>% mutate(metode = "rating"), imp_choice %>% mutate(metode = "choice")) %>%
  select(atribut, metode, importance) %>% pivot_wider(names_from = metode, values_from = importance)

bind_rows(pw_rating %>% mutate(metode = "rating", pw_z = pw / sd(pw)),
          pw_choice %>% mutate(metode = "choice", pw_z = pw / sd(pw))) %>%
  ggplot(aes(x = factor(level, levels = unique(level)), y = pw_z, colour = metode, group = metode)) +
