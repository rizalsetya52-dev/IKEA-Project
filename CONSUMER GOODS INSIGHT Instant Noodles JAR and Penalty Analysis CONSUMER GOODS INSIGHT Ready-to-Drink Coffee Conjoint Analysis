lev <- list(harga_f    = c("10000", "12000", "14000"),
            ukuran_f   = c("180", "250", "300"),
            intensitas = c("Mild", "Medium", "Strong"),
            varian     = c("Original Latte", "Mocha", "Caramel Latte"))

prep <- function(d) d %>% mutate(
  harga_f    = factor(harga_rp, levels = c(10000, 12000, 14000)),
  ukuran_f   = factor(ukuran_ml, levels = c(180, 250, 300)),
  intensitas = factor(intensitas, levels = lev$intensitas),
  varian     = factor(varian, levels = lev$varian),
  harga_k    = harga_rp / 1000)

rating <- df_conj %>% filter(metode == "rating") %>% prep()
choice <- df_conj %>% filter(metode == "choice") %>% prep()

# helper: part-worth & importance
pw_from_coef <- function(b) {            # dari koefisien effect-coded (level terakhir = -jumlah)
  bind_rows(lapply(names(lev), function(a) {
    cf <- b[paste0(a, 1:(length(lev[[a]]) - 1))]
    tibble(atribut = a, level = lev[[a]], pw = c(cf, -sum(cf)))
  }))
}
importance <- function(pw) pw %>% group_by(atribut) %>%
  summarise(range = max(pw) - min(pw), .groups = "drop") %>%
  mutate(importance = round(100 * range / sum(range), 1)) %>% arrange(desc(importance))

