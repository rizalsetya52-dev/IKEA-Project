# A1. Rata-rata kesukaan per produk (+ uji beda antar produk, within-subject)
df_jar %>% group_by(produk_kode) %>%
  summarise(n = n(), mean_liking = mean(suka_keseluruhan), sd = sd(suka_keseluruhan))

summary(aov(suka_keseluruhan ~ produk_kode + Error(respondent_id / produk_kode), data = df_jar))
