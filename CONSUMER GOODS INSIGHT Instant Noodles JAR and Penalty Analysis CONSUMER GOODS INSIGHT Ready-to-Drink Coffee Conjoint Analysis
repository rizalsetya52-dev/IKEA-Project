  facet_wrap(~atribut, scales = "free_x") + labs(title = "Rating vs Choice (distandarisasi)", x = NULL, y = "Part-worth (z)")

# D4. Heterogenitas lewat interaksi dengan profil responden
m_int <- clogit(pilih ~ harga_f + ukuran_f + intensitas + varian +
                  intensitas:frekuensi_minum_kopi_per_minggu +
                  varian:preferensi_manis +
                  harga_f:I(pendapatan_bulanan == "<Rp2 juta") + strata(task_id), data = choice)
summary(m_int)
anova(m_choice, m_int)    # apakah interaksi memperbaiki model?

# D5. Segmen proxy dari profil (sekadar pendekatan, bukan latent class)
choice <- choice %>% mutate(seg_proxy = case_when(
  frekuensi_minum_kopi_per_minggu >= 5 & preferensi_manis <= 3 ~ "Kopi_serius",
  preferensi_manis >= 4                                         ~ "Suka_manis",
  TRUE                                                          ~ "Lainnya"))
table(distinct(choice, respondent_id, seg_proxy)$seg_proxy)

seg_models <- choice %>% group_split(seg_proxy) %>%
  setNames(sort(unique(choice$seg_proxy))) %>%
  map(~ clogit(pilih ~ harga_f + ukuran_f + intensitas + varian + strata(task_id), data = .x))
map(seg_models, ~ importance(pw_from_coef(coef(.x))))
map(seg_models, ~ pw_from_coef(coef(.x)) %>% filter(atribut %in% c("intensitas", "varian")))

# D6. Mixed logit (heterogenitas acak), opsional: tergantung versi mlogit
choice_ml <- choice %>% mutate(pilih = as.logical(pilih))
ml_try <- tryCatch({
  idx <- dfidx(choice_ml, idx = list(c("task_id", "respondent_id"), "alt"))
  m0  <- mlogit(pilih ~ harga_k + ukuran_f + intensitas + varian | 0, data = idx)
  rnd <- names(coef(m0))[grepl("^(intensitas|varian)", names(coef(m0)))]
  mlogit(pilih ~ harga_k + ukuran_f + intensitas + varian | 0, data = idx,
         rpar = setNames(rep("n", length(rnd)), rnd), R = 200, halton = NA, panel = TRUE)
}, error = function(e) { message("Mixed logit gagal: ", conditionMessage(e)); NULL })
if (!is.null(ml_try)) summary(ml_try)    # lihat sd.* yang signifikan = preferensi heterogen

