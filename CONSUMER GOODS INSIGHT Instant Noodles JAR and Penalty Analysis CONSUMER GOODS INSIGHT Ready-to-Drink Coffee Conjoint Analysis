# C1. Eksplorasi cepat
rating %>% group_by(harga_rp) %>% summarise(mean_wtb = mean(wtb))
rating %>% group_by(intensitas) %>% summarise(mean_wtb = mean(wtb))

# C2. Mixed model (consumer = random effect), seperti poster Nofima
m_rating <- lmer(wtb ~ harga_f + ukuran_f + intensitas + varian + (1 | respondent_id), data = rating)
summary(m_rating)
anova(m_rating)                                      # signifikansi main effect

# C3. Part-worth & importance
pw_rating <- pw_from_coef(fixef(m_rating))
pw_rating
imp_rating <- importance(pw_rating); imp_rating

ggplot(pw_rating, aes(x = factor(level, levels = unique(level)), y = pw, group = 1)) +
  geom_line() + geom_point() + geom_hline(yintercept = 0, linetype = "dashed") +
  facet_wrap(~atribut, scales = "free_x") +
  labs(title = "Part-worth (Rating-based)", x = NULL, y = "Part-worth")

# C4. Segmentasi: part-worth individual -> k-means
ind_pw <- rating %>%
  group_by(respondent_id) %>%
  group_modify(~ as_tibble(as.list(coef(lm(wtb ~ harga_f + ukuran_f + intensitas + varian, data = .x))))) %>%
  ungroup()

set.seed(123)
km <- kmeans(scale(ind_pw %>% select(-respondent_id, -`(Intercept)`)), centers = 3, nstart = 25)
seg_rating <- tibble(respondent_id = ind_pw$respondent_id, cluster = factor(km$cluster))

rating_seg <- rating %>% left_join(seg_rating, by = "respondent_id")
rating_seg %>% group_by(cluster, intensitas) %>% summarise(mean_wtb = mean(wtb), .groups = "drop") %>%
  pivot_wider(names_from = intensitas, values_from = mean_wtb)
# profil tiap cluster
rating_seg %>% distinct(respondent_id, cluster, usia, gender, preferensi_manis,
                        frekuensi_minum_kopi_per_minggu, pendapatan_bulanan) %>%
  group_by(cluster) %>%
  summarise(n = n(), usia = mean(usia), pct_perempuan = 100 * mean(gender == "Perempuan"),
            manis = mean(preferensi_manis), freq_kopi = mean(frekuensi_minum_kopi_per_minggu))

