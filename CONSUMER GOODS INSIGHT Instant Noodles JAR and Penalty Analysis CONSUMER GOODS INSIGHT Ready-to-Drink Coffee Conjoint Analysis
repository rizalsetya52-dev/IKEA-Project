# A2. Ubah ke format long per atribut + kategori JAR
#     Kaldu/Asin/Pedas : 1-2 kurang, 3 pas, 4-5 terlalu
#     Tekstur          : Too little = terlalu LEMBEK, Too much = terlalu KERAS
jar_long <- df_jar %>%
  pivot_longer(c(kaldu, keasinan, kepedasan, tekstur_mi), names_to = "atribut", values_to = "skor") %>%
  mutate(kategori = factor(case_when(skor <= 2 ~ "Too little", skor == 3 ~ "JAR", TRUE ~ "Too much"),
                           levels = c("Too little", "JAR", "Too much")))

# A3. Distribusi % per produk x atribut
jar_dist <- jar_long %>%
  count(produk_kode, atribut, kategori) %>%
  group_by(produk_kode, atribut) %>%
  mutate(pct = round(100 * n / sum(n), 1)) %>% ungroup()
jar_dist %>% select(-n) %>% pivot_wider(names_from = kategori, values_from = pct, values_fill = 0)

ggplot(jar_dist, aes(x = atribut, y = pct, fill = kategori)) +
  geom_col() + coord_flip() + facet_wrap(~produk_kode) +
  scale_fill_manual(values = c("Too little" = "#E69F00", "JAR" = "#009E73", "Too much" = "#D55E00")) +
  labs(title = "Distribusi JAR per produk", x = NULL, y = "% responden", fill = NULL)

# A4. Penalty analysis (threshold 20% + mean drop + uji t)
penalty <- jar_long %>%
  group_by(produk_kode, atribut) %>%
  group_modify(~ {
    d <- .x
    y <- d$suka_keseluruhan[d$kategori == "JAR"]
    map_dfr(c("Too little", "Too much"), function(k) {
      x <- d$suka_keseluruhan[d$kategori == k]
      tibble(arah = k, n = length(x), pct = 100 * length(x) / nrow(d),
             mean_drop = mean(y) - mean(x),
             weighted_penalty = (length(x) / nrow(d)) * (mean(y) - mean(x)),
             p_value = if (length(x) > 1 && length(y) > 1) t.test(y, x)$p.value else NA_real_)
    })
  }) %>% ungroup()

penalty %>% mutate(across(where(is.numeric), ~ round(.x, 3))) %>% arrange(desc(weighted_penalty))

# prioritas perbaikan: >=20% responden, drop positif, signifikan
prioritas <- penalty %>% filter(pct >= 20, mean_drop > 0, p_value < 0.05) %>% arrange(desc(weighted_penalty))
prioritas

