# PART E. MARKET SIMULATION (share of preference)
# =====================================================================
concepts <- tribble(
  ~nama,           ~harga_rp, ~ukuran_ml, ~intensitas, ~varian,
  "Value",          10000,     250,        "Medium",    "Original Latte",
  "Premium",        14000,     250,        "Strong",    "Mocha",
  "Sweet",          12000,     250,        "Mild",      "Caramel Latte")

sim_share <- function(b, concepts) {
  pw <- pw_from_coef(b)
  get <- function(a, l) pw$pw[pw$atribut == a & pw$level == as.character(l)]
  u <- sapply(seq_len(nrow(concepts)), function(i)
    get("harga_f", concepts$harga_rp[i]) + get("ukuran_f", concepts$ukuran_ml[i]) +
      get("intensitas", concepts$intensitas[i]) + get("varian", concepts$varian[i]))
  tibble(nama = concepts$nama, share = round(100 * exp(u) / sum(exp(u)), 1))
}

sim_share(coef(m_choice), concepts)                       # seluruh pasar
map(seg_models, ~ sim_share(coef(.x), concepts))          # per segmen proxy

