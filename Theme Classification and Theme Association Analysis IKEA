  library(dplyr)

# tema_matrix udah ada dari kode sebelumnya (0/1 per tema)
# kalau session R kamu udah ke-reset, jalanin ulang ini dulu:
tema_matrix <- asalmuasal_tema %>% 
  select(starts_with("tema_")) %>% 
  mutate(across(everything(), as.numeric)) %>% 
  as.matrix()

nama_tema <- c("Tempat/Fasilitas", "Produk/Perlengkapan", "Makanan/Food Court", "Harga", "Akses/Lokasi")
colnames(tema_matrix) <- nama_tema

# fungsi buat bikin tabel kontingensi 2x2 & jalanin chi-square per pasangan
uji_chi_pasangan <- function(matrix_tema, tema_a, tema_b) {
  a <- matrix_tema[, tema_a]
  b <- matrix_tema[, tema_b]
  
  # tabel kontingensi 2x2: ada/nggak A x ada/nggak B
  tabel <- table(a, b)
  
  hasil <- suppressWarnings(chisq.test(tabel, correct = TRUE))  # correct=TRUE = Yates' correction, lebih aman buat sel kecil
  
  data.frame(
    pasangan = paste(tema_a, "-", tema_b),
    observed = sum(a == 1 & b == 1),
    chi_square = round(hasil$statistic, 3),
    p_value = round(hasil$p.value, 4),
    signifikan = ifelse(hasil$p.value < 0.05, "Ya (p < 0.05)", "Tidak")
  )
}

# generate semua kombinasi pasangan tema (tanpa duplikat)
pasangan_list <- combn(nama_tema, 2, simplify = FALSE)

# jalanin buat semua pasangan, gabungin jadi 1 tabel
hasil_chi <- bind_rows(lapply(pasangan_list, function(p) {
  uji_chi_pasangan(tema_matrix, p[1], p[2])
}))

# urutin dari yang paling signifikan (p paling kecil)
hasil_chi <- hasil_chi %>% arrange(p_value)

print(hasil_chi)  



# gabung dengan lift yang udah dihitung sebelumnya
