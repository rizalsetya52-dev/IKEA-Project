### Kita Sentiment Pake InSet Lexicon (Fajri Koto)
library(dplyr)
library(stringr)
library(readr)

# Download ulang tanpa maksa nama kolom manual - biarkan pakai header asli file
positif <- read_tsv("https://raw.githubusercontent.com/fajri91/InSet/master/positive.tsv")
negatif <- read_tsv("https://raw.githubusercontent.com/fajri91/InSet/master/negative.tsv")

# Gabungkan jadi 1 kamus, pastikan kolom weight jadi angka
lexicon_inset <- bind_rows(positif, negatif) %>%
  mutate(weight = as.numeric(weight))

# Cek ulang isinya
head(lexicon_inset, 10)

library(tidytext)
library(dplyr)
library(stringr)

# 1. Pecah tiap komentar jadi kata-kata (tokenisasi), sambil bawa ID unik per komentar
asalmuasal_sentimen <- asalmuasal_tema %>%
  mutate(komentar_id = row_number()) %>%
  select(komentar_id, komentar, label_tema)

kata_per_komentar <- asalmuasal_sentimen %>%
  unnest_tokens(word, komentar)

# 2. Cocokkan tiap kata dengan skor di lexicon InSet
kata_dengan_skor <- kata_per_komentar %>%
  left_join(lexicon_inset, by = "word")

# 3. Jumlahkan skor per komentar (kata yang tidak ada di lexicon otomatis dianggap 0)
skor_sentimen <- kata_dengan_skor %>%
  mutate(weight = ifelse(is.na(weight), 0, weight)) %>%
  group_by(komentar_id) %>%
  summarise(skor_total = sum(weight)) %>%
  mutate(
    sentimen = case_when(
      skor_total > 0 ~ "Positif",
      skor_total < 0 ~ "Negatif",
      TRUE ~ "Netral"
    )
  )

# 4. Gabungkan skor sentiment ke data asli (biar ada komentar, tema, dan sentiment jadi satu)
asalmuasal_final <- asalmuasal_sentimen %>%
  left_join(skor_sentimen, by = "komentar_id")

# 5. Cek distribusi sentiment secara keseluruhan
table(asalmuasal_final$sentimen)

